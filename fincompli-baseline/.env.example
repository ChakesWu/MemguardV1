# LLM Configuration (local Qwen via llama.cpp llama-server)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-IQ3_M.gguf
LLM_API_KEY=not-needed-for-local

# Database Paths
CHROMA_DB_PATH=./data/chroma
SQLITE_DB_PATH=./data/sqlite/fincompli.db

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_RISK_SCORE=0.85          # Above this score triggers manual review
AUTO_APPROVE_THRESHOLD=0.30  # Below this score auto-approves

# Mock Settings
ENABLE_MOCK_DATA=true
TRANSACTION_STREAM_DELAY=0   # seconds, 0 means immediate

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
